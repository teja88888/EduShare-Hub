# EduShare Hub Environment Configuration
PORT=3000
NODE_ENV="development"
JWT_SECRET="edushare-hub-super-secure-jwt-secret-key-2026"

# Optional: Remote MongoDB connection string (if omitted, high-performance file-backed persistent MongoDB-compatible database engine is used automatically)
MONGODB_URI="mongodb://localhost:27017/edushare"

# Maximum upload size in bytes (e.g., 26214400 for 25MB)
MAX_FILE_SIZE=26214400

# GEMINI_API_KEY: Optional runtime secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
